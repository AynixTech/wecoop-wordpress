# BEGIN WeCoop deep links
<IfModule mod_rewrite.c>
RewriteEngine On

# Anteprima annuncio condivisibile (WhatsApp/social): /annunci/123 -> annunci.php?id=123
RewriteRule ^annunci/(\d+)/?$ /annunci.php?id=$1 [L,QSA]

# File di associazione app (Universal Link iOS / App Link Android).
# Servono senza estensione e come JSON puro.
RewriteRule ^\.well-known/apple-app-site-association$ /.well-known/apple-app-site-association [L]
RewriteRule ^\.well-known/assetlinks\.json$ /.well-known/assetlinks.json [L]
</IfModule>
# END WeCoop deep links

# BEGIN WordPress
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /
RewriteRule ^index\.php$ - [L]

# JWT Authentication - Allow Authorization header
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>
# END WordPress

# Allow access to media files in uploads (required for plugins like Custom Facebook Feed)
<FilesMatch "\.(jpg|jpeg|png|gif|pdf|mp4|webm|ogg|css|js)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        allow from all
    </IfModule>
</FilesMatch>

# apple-app-site-association deve essere servito come JSON, senza estensione.
<Files "apple-app-site-association">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    ForceType application/json
</Files>
